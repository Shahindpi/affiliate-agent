PUT http://localhost:8000/api/admin/categories/1
Accept: application/json
Content-Type: application/json

{
  "name": "AI Tools Updated"
}

###

### ============================================================
### 4. Verify Public Category Cache Cleared
### ============================================================

GET http://localhost:8000/api/public/categories/ai-tools-updated
Accept: application/json

###

### ============================================================
### 5. Verify Categories List Cache Cleared
### ============================================================

GET http://localhost:8000/api/public/categories
Accept: application/json

###

### ============================================================
### 6. Create New Category
### ============================================================

POST http://localhost:8000/api/admin/categories
Accept: application/json
Content-Type: application/json

{
  "name": "AI Automation"
}

###

### ============================================================
### 7. Delete Category (Use an Empty Category ID)
### ============================================================

DELETE http://localhost:8000/api/admin/categories/3
Accept: application/json

@baseUrl = http://localhost:8000

