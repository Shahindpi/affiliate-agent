Accept: application/json
Content-Type: application/json

{
  "name": "AI Agents"
}

###

### Update Tag

PUT {{baseUrl}}/api/admin/tags/1
Accept: application/json
Content-Type: application/json

{
  "name": "AI Tools Updated"
}

###

### Verify Public Tag Cache Cleared

GET {{baseUrl}}/api/public/tags/ai-tools-updated
Accept: application/json

###

### Verify Tags List Cache Cleared

GET {{baseUrl}}/api/public/tags
Accept: application/json

###

### Delete Tag

DELETE {{baseUrl}}/api/admin/tags/3
Accept: application/json


###

### Create Affiliate Product

POST {{baseUrl}}/api/admin/affiliate-products
Accept: application/json
Content-Type: application/json

{
  "category_id": 1,
  "name": "Claude Pro",
  "affiliate_url": "https://example.com/claude-pro"
}

###

### Update Affiliate Product

PUT {{baseUrl}}/api/admin/affiliate-products/1
Accept: application/json
Content-Type: application/json

{
  "name": "ChatGPT Plus Updated",
  "featured": true
}

###

### Verify Public Product Cache Cleared

GET {{baseUrl}}/api/public/products/chatgpt-plus-updated
Accept: application/json

###

### Verify Product List Cache Cleared

GET {{baseUrl}}/api/public/products
Accept: application/json

###

### Delete Affiliate Product

DELETE {{baseUrl}}/api/admin/affiliate-products/2
Accept: application/json